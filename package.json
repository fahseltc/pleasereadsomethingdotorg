{
  "name": "pleasereadsomething",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static site for Front Range independent bookstore reviews: blog, a map of reviewed stores, and simple npm authoring commands.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "preview:local": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "new:post": "node scripts/new-post.mjs",
    "new:bookstore": "node scripts/new-bookstore.mjs",
    "new:library": "node scripts/new-library.mjs",
    "disable:bookstore": "node scripts/toggle-entry.mjs disable bookstore",
    "enable:bookstore": "node scripts/toggle-entry.mjs enable bookstore",
    "disable:library": "node scripts/toggle-entry.mjs disable library",
    "enable:library": "node scripts/toggle-entry.mjs enable library",
    "geocode": "node scripts/geocode.mjs",
    "sync:events": "node scripts/sync-events.mjs",
    "publish": "node scripts/publish.mjs",
    "update": "node scripts/update.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.1",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}