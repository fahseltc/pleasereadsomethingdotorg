# Local settings for this site. Copy this file to `.env` and fill in the real
# values. `.env` is gitignored; `.env.example` is the committed template (no
# real values).
#
# Two kinds of values live here, and they are handled differently:
#
# 1. Secrets. YOUTUBE_API_KEY is a real secret. Scripts read it at build time
#    only. Never put it in a PUBLIC_ variable or anywhere else that reaches the
#    published page. In CI it comes from a GitHub Actions secret.
#
# 2. Public values. PUBLIC_* contact addresses render into the published HTML,
#    so anyone who views the page can see them. The PUBLIC_ prefix makes that
#    explicit. Env keeps these out of the git repository, not out of the browser.
#    In CI they come from GitHub Actions secrets too (see the README's deploy
#    section and .github/workflows/deploy.yml).

# YouTube Data API key, read by `npm run sync:youtube` (and `npm run build`) to
# refresh the list of channel Shorts. Create a key in Google Cloud Console,
# enable "YouTube Data API v3", and restrict the key to that API. Leave it blank
# to skip the refresh; the last saved list is kept.
YOUTUBE_API_KEY=

# General contact — the public "tell me about your bookstore" inbox.
PUBLIC_CONTACT_EMAIL=contact@example.com

# Tech support / problems with the site.
PUBLIC_ADMIN_EMAIL=admin@example.com
