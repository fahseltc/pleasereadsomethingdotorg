---
import { withBase } from '../lib/url';
import '../styles/tokens.css';
import '../styles/themes/classic.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const siteName = 'Please Read Something';
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;

// Analytics: GoatCounter — privacy-friendly, cookieless, no consent banner.
// The endpoint is a public value (ships in the HTML), so no secret is involved.
// Currently enabled everywhere INCLUDING dev (so local clicks show up while we
// test); to stop dev from counting later, gate this with `import.meta.env.PROD`.
const GOATCOUNTER_ENDPOINT = 'https://pleasereadsomething.goatcounter.com/count';

// The site-wide DEFAULT look. Change this one value to reskin the whole site
// (design §12). A visitor's saved choice (localStorage) overrides it at runtime.
const DEFAULT_THEME = 'classic';
const DEFAULT_MODE = 'light';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/events', label: 'Events' },
  { href: '/libraries', label: 'Libraries' },
  { href: '/bookstores', label: 'Bookstores' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Contact' },
];

// Footer social links. Swap the href values for the real accounts; the icons
// are inline SVGs (dependency-free, inherit the footer text color).
const social = [
  {
    label: 'YouTube',
    href: 'https://www.youtube.com/@justpleasereadsomething',
    icon: '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true" focusable="false"><path d="M23.5 6.2a3 3 0 0 0-2.11-2.12C19.5 3.56 12 3.56 12 3.56s-7.5 0-9.39.52A3 3 0 0 0 .5 6.2 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .5 5.8 3 3 0 0 0 2.11 2.12c1.89.52 9.39.52 9.39.52s7.5 0 9.39-.52a3 3 0 0 0 2.11-2.12A31.3 31.3 0 0 0 24 12a31.3 31.3 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z"/></svg>',
  },
  {
    label: 'Bluesky',
    href: 'https://bsky.app/profile/craftedbibliophile.bsky.social',
    icon: '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true" focusable="false"><path d="M5.2 3.3C7.9 5.3 10.8 9.4 12 11.6c1.2-2.2 4.1-6.3 6.8-8.3 1.9-1.5 5.2-2.6 5.2 1.2 0 .8-.4 6.4-.7 7.3-.8 3.2-4 4-6.9 3.5 5 .9 6.3 3.7 3.5 6.6-5.2 5.3-7.5-1.3-8.1-3-.1-.3-.2-.5-.2-.3 0-.2-.1 0-.2.3-.6 1.7-2.9 8.3-8.1 3C-1.5 18.8-.2 16 4.8 15.1c-2.9.5-6.1-.3-6.9-3.5-.3-.9-.7-6.5-.7-7.3 0-3.8 3.3-2.7 5.2-1.2z" transform="translate(2.6 0)"/></svg>',
  },
];

const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
function isActive(href: string) {
  const target = withBase(href).replace(/\/+$/, '') || '/';
  return current === target;
}
---

<!doctype html>
<html lang="en" data-theme={DEFAULT_THEME} data-mode={DEFAULT_MODE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/favicon.svg')} />
    <meta name="color-scheme" content="light dark" />
    <!-- Apply the saved light/dark mode BEFORE paint to avoid a flash. -->
    <script is:inline>
      (function () {
        try {
          var m = localStorage.getItem('prs-mode');
          if (m) document.documentElement.setAttribute('data-mode', m);
        } catch (e) {}
      })();
    </script>
    <!-- GoatCounter: cookieless pageview analytics (auto-counts on load). -->
    <script
      data-goatcounter={GOATCOUNTER_ENDPOINT}
      async
      src="//gc.zgo.at/count.js"></script>
  </head>
  <body>
    <div class="beta-banner" role="note">
      🚧 This site is under construction -
      details may change and some events may be incorrect 🚧
    </div>
    <header class="site-header">
      <div class="container">
        <a class="site-title" href={withBase('/')}>
          <img
            class="site-logo"
            src={withBase('/images/logos/round-logo-yellow.svg')}
            alt=""
            width="36"
            height="36"
          />
          <span>Please Read Something</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          {
            nav.map((item) => (
              <a
                href={withBase(item.href)}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <div class="theme-switcher">
          <button id="mode-toggle" class="button button--ghost" type="button" aria-label="Toggle light/dark">
            ◐
          </button>
        </div>
      </div>
    </header>

    <main>
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container footer-row">
        <p class="small">
          Please Read Something — independent bookstore reviews for Colorado's
          Front Range.
        </p>
        <ul class="social-links" aria-label="Social media">
          {
            social.map((s) => (
              <li>
                <a
                  class="social-link"
                  href={s.href}
                  aria-label={s.label}
                  title={s.label}
                  target="_blank"
                  rel="me noopener"
                  set:html={s.icon}
                />
              </li>
            ))
          }
        </ul>
        <p class="small footer-attribution">
          Map data © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>
          contributors.
        </p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var modeBtn = document.getElementById('mode-toggle');
        var root = document.documentElement;
        if (modeBtn) {
          modeBtn.addEventListener('click', function () {
            var next = root.getAttribute('data-mode') === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-mode', next);
            try { localStorage.setItem('prs-mode', next); } catch (e) {}
          });
        }
      })();
    </script>
  </body>
</html>
