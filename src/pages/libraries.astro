---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LibraryCard from '../components/LibraryCard.astro';
import Map, { type MapPin } from '../components/Map.astro';
import { withBase } from '../lib/url';

// Only enabled libraries with resolved coordinates appear on the map.
const libraries = (await getCollection('libraries'))
  .filter((l) => l.data.enabled)
  .sort((a, b) => a.data.name.localeCompare(b.data.name));

const mapped = libraries.filter(
  (l) => typeof l.data.lat === 'number' && typeof l.data.lng === 'number'
);

const pins: MapPin[] = mapped.map((l) => ({
  id: l.data.id,
  name: l.data.name,
  lat: l.data.lat as number,
  lng: l.data.lng as number,
  image: l.data.image,
  href: withBase(`/libraries/${l.data.id}`),
}));

const allTags = Array.from(new Set(libraries.flatMap((l) => l.data.tags))).sort();
---

<BaseLayout
  title="Libraries"
  description="A map and index of public libraries along Colorado's Front Range."
>
  <section class="section stack">
    <h1>Front Range Libraries</h1>
    <p class="lede">
      {mapped.length} librar{mapped.length === 1 ? 'y' : 'ies'} on the map. Tap a
      pin for details, or browse the list below.
    </p>
    <Map pins={pins} mode="all" />
  </section>

  <section class="section">
    <div class="cluster" style="justify-content: space-between;">
      <h2>All libraries</h2>
      {
        allTags.length > 0 && (
          <div class="cluster">
            <label for="tag-filter" class="small muted">
              Filter by tag:
            </label>
            <select id="tag-filter" class="theme-switcher">
              <option value="">All</option>
              {allTags.map((t) => (
                <option value={t}>{t}</option>
              ))}
            </select>
          </div>
        )
      }
    </div>

    <div class="grid" id="library-grid">
      {
        libraries.map((library) => (
          <div class="library-item" data-tags={library.data.tags.join(' ')}>
            <LibraryCard library={library} />
          </div>
        ))
      }
    </div>
  </section>

  <script is:inline>
    (function () {
      var sel = document.getElementById('tag-filter');
      if (!sel) return;
      sel.addEventListener('change', function () {
        var tag = sel.value;
        document.querySelectorAll('.library-item').forEach(function (el) {
          var tags = (el.getAttribute('data-tags') || '').split(' ');
          el.style.display = !tag || tags.indexOf(tag) !== -1 ? '' : 'none';
        });
      });
    })();
  </script>
</BaseLayout>
