---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import YouTubeIcon from '../../components/YouTubeIcon.astro';
import { withBase } from '../../lib/url';
import { excerptFromBody } from '../../lib/excerpt';

// Every non-draft post lists, store/library-linked or not (design §8).
const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// A post may be "about" a bookstore OR a library (both optional). Resolve the
// linked place for the "about <place>" tag — name + the right detail-page path.
const placeByPostId = new Map<string, { name: string; href: string }>();
for (const post of posts) {
  if (post.data.bookstore) {
    const store = await getEntry('bookstores', post.data.bookstore.id);
    if (store) {
      placeByPostId.set(post.id, {
        name: store.data.name,
        href: withBase(`/bookstores/${store.data.id}`),
      });
    }
  } else if (post.data.library) {
    const lib = await getEntry('libraries', post.data.library.id);
    if (lib) {
      placeByPostId.set(post.id, {
        name: lib.data.name,
        href: withBase(`/libraries/${lib.data.id}`),
      });
    }
  }
}
---

<BaseLayout
  title="Blog"
  description="Articles about the Front Range's independent bookstores and libraries — reviews, roundups, and news."
>
  <section class="section stack">
    <h1>Blog</h1>
    {posts.length === 0 && <p class="muted">No posts yet. Check back soon.</p>}
    <ul class="stack">
      {
        posts.map((post) => (
          <li class="card">
            <div class="card__body">
              <a href={withBase(`/blog/${post.id}`)}>
                <h3>
                  {post.data.youtube && <YouTubeIcon />}
                  {post.data.title}
                </h3>
              </a>
              <p class="small muted">
                {post.data.pubDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
                {post.data.author && <span class="tag">{post.data.author}</span>}
                {placeByPostId.get(post.id) && (
                  <>
                    {' · about '}
                    <a href={placeByPostId.get(post.id)!.href}>
                      {placeByPostId.get(post.id)!.name}
                    </a>
                  </>
                )}
              </p>
              {(() => {
                const summary = post.data.description || excerptFromBody(post.body);
                return summary ? <p>{summary}</p> : null;
              })()}
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
