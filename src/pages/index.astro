---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BookstoreCard from '../components/BookstoreCard.astro';
import { withBase } from '../lib/url';

const stores = (await getCollection('bookstores'))
  .filter((s) => s.data.enabled)
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
const featured = stores.slice(0, 3);

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---

<BaseLayout
  title="Please Read Something"
  description="Reviews of independent bookstores along Colorado's Front Range, with a map, a blog, and directions to every shop."
>
  <section class="section prose stack">
    <h1>Please Read Something</h1>
    <p class="lede">
      Honest reviews of the independent bookstores along Colorado's Front Range -
      what each shop is good at, where to find it, and what's happening there.
    </p>
    <p class="cluster">
      <a class="button" href={withBase('/bookstores')}>Browse the map</a>
      <a class="button button--ghost" href={withBase('/blog')}>Read the blog</a>
    </p>
  </section>

  {
    featured.length > 0 && (
      <section class="section">
        <h2>Featured bookstores</h2>
        <div class="grid">
          {featured.map((store) => (
            <BookstoreCard store={store} />
          ))}
        </div>
      </section>
    )
  }

  {
    posts.length > 0 && (
      <section class="section">
        <h2>Latest from the blog</h2>
        <ul class="stack">
          {posts.map((post) => (
            <li>
              <a href={withBase(`/blog/${post.id}`)}>
                <strong>{post.data.title}</strong>
              </a>
              <span class="muted small">
                {' '}
                — {post.data.pubDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
