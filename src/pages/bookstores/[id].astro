---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Map, { type MapPin } from '../../components/Map.astro';
import { withBase } from '../../lib/url';
import { snippet } from '../../lib/seo';
import { placeJsonLd, breadcrumbJsonLd, eventJsonLd } from '../../lib/jsonld';
import YouTube from '../../components/YouTube.astro';
import NearbyStores from '../../components/NearbyStores.astro';
import { nearbyStores } from '../../lib/nearby';
import { upcomingEventsForStore } from '../../lib/events';
import { BOOKSTORE_COLOR } from '../../lib/map-colors';

export const getStaticPaths = (async () => {
  const stores = await getCollection('bookstores');
  return stores.map((store) => ({
    params: { id: store.data.id },
    props: { store },
  }));
}) satisfies GetStaticPaths;

const { store } = Astro.props;
const d = store.data;

// Related blog posts: non-draft posts whose `bookstore` reference is this store.
const relatedPosts = (await getCollection('blog'))
  .filter((p) => !p.data.draft && p.data.bookstore?.id === d.id)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Related upcoming events via the aggregator bridge (empty if not synced).
const events = await upcomingEventsForStore({
  name: d.name,
  sourceAliases: d.sourceAliases,
});

const hasCoords = typeof d.lat === 'number' && typeof d.lng === 'number';
const pins: MapPin[] = hasCoords
  ? [
      {
        id: d.id,
        name: d.name,
        lat: d.lat as number,
        lng: d.lng as number,
        image: d.image,
        href: withBase(`/bookstores/${d.id}`),
        color: BOOKSTORE_COLOR,
      },
    ]
  : [];
// Other enabled stores, nearest first (see lib/nearby.ts).
const nearby = nearbyStores(
  d,
  (await getCollection('bookstores')).filter((s) => s.data.enabled).map((s) => s.data),
);
// Structured data (JSON-LD): the place itself, breadcrumbs, and its upcoming events.
const ldPath = `/bookstores/${d.id}`;
const ld = [
  placeJsonLd('BookStore', d, ldPath),
  breadcrumbJsonLd([{ name: 'Bookstores', path: '/bookstores' }, { name: d.name, path: ldPath }]),
  ...events.map((e) => eventJsonLd(e, { type: 'BookStore', name: d.name, address: d.address, path: ldPath })),
];
---
<BaseLayout title={d.name} description={snippet(d.review)} jsonLd={ld}>
  <article class="section stack">
    <p>
      <a href={withBase('/bookstores')}>← All bookstores</a>
    </p>

    <h1>{d.name}</h1>

    <img
      src={withBase(d.image)}
      alt={`${d.name} storefront`}
      width="960"
      height="640"
      style="border-radius: var(--radius); border: var(--card-border);"
    />

    <div class="prose stack">
      <p>{d.review}</p>
      {d.youtube && <YouTube url={d.youtube} title={`${d.name} review video`} />}

      <p class="stack">
        <span><strong>Address:</strong> {d.address}</span>
        <span class="cluster">
          {d.mapsLink && (
            <a
              class="button button--ghost"
              href={d.mapsLink}
              target="_blank"
              rel="noopener noreferrer"
            >
              Get directions
            </a>
          )}
          {d.website && (
            <a
              class="button button--ghost"
              href={d.website}
              target="_blank"
              rel="noopener noreferrer"
            >
              Visit website
            </a>
          )}
        </span>
      </p>

      {
        d.tags.length > 0 && (
          <ul class="tags">
            {d.tags.map((t) => (
              <li class="tag">{t}</li>
            ))}
          </ul>
        )
      }
    </div>

    {
      relatedPosts.length > 0 && (
        <section class="section">
          <h2>From the blog</h2>
          <ul class="stack">
            {relatedPosts.map((p) => (
              <li>
                <a href={withBase(`/blog/${p.id}`)}>{p.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      pins.length > 0 && (
        <section class="section">
          <h2>Find it</h2>
          <Map pins={pins} mode="single" class="map--detail" />
        </section>
      )
    }

    {
      events.length > 0 && (
        <section class="section">
          <h2>Upcoming events</h2>
          <ul class="stack">
            {events.map((e) => (
              <li>
                {e.url ? (
                  <a href={e.url} target="_blank" rel="noopener noreferrer">
                    {e.title}
                  </a>
                ) : (
                  e.title
                )}
                <span class="muted small">
                  {' '}
                  —{' '}
                  {new Date(e.start).toLocaleDateString('en-US', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric',
                  })}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
    <NearbyStores city={nearby.city} stores={nearby.stores} allSameCity={nearby.allSameCity} />
  </article>
</BaseLayout>
