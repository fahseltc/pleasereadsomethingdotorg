---
/*
 * Map.astro — Leaflet + OpenStreetMap map (design §7).
 *
 * Renders one pin per ENABLED bookstore that has resolved coordinates. Disabled
 * stores (or ones still missing lat/lng) are filtered out by the caller and/or
 * here, so a hidden store never ships a pin. No API key, no billing.
 *
 * Leaflet's CSS/JS are pinned to a specific version with SRI for reproducible,
 * tamper-evident loads.
 */
import { withBase } from '../lib/url';

export interface MapPin {
  id: string;
  name: string;
  lat: number;
  lng: number;
  image?: string;
  href: string;
  /** Optional category label shown on the pin popup (e.g. "Bookstore"). */
  category?: string;
  /** Optional pin color (CSS color). Falls back to the theme accent. */
  color?: string;
}

interface LegendItem {
  label: string;
  color: string;
}

interface Props {
  pins: MapPin[];
  /** Fit all pins (index map) or center on one (detail map). */
  mode?: 'all' | 'single';
  /** Extra class on the map container, e.g. for the shorter detail map. */
  class?: string;
  /** Optional color key rendered under the map. */
  legend?: LegendItem[];
}

const { pins, mode = 'all', class: className = '', legend = [] } = Astro.props;

// Denver fallback center when there are zero/one pins.
const DENVER = { lat: 39.7392, lng: -104.9903, zoom: 11 };

const payload = {
  pins,
  mode,
  denver: DENVER,
  // Resolve the image base path server-side so popups work under a Pages subpath.
  base: withBase('/'),
};

const LEAFLET_VERSION = '1.9.4';
const LEAFLET_CSS = `https://unpkg.com/leaflet@${LEAFLET_VERSION}/dist/leaflet.css`;
const LEAFLET_CSS_SRI =
  'sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=';
const LEAFLET_JS = `https://unpkg.com/leaflet@${LEAFLET_VERSION}/dist/leaflet.js`;
const LEAFLET_JS_SRI =
  'sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=';
---

<link
  rel="stylesheet"
  href={LEAFLET_CSS}
  integrity={LEAFLET_CSS_SRI}
  crossorigin="anonymous"
/>

<div
  class={`map ${className}`.trim()}
  id="prs-map"
  data-map={JSON.stringify(payload)}
  role="application"
  aria-label="Map of Front Range bookstores and libraries"
>
</div>

{
  legend.length > 0 && (
    <ul class="map-legend" aria-label="Map key">
      {legend.map((item) => (
        <li class="map-legend__item">
          <span class="map-legend__dot" style={`background:${item.color}`} />
          {item.label}
        </li>
      ))}
    </ul>
  )
}

<style>
  .map-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space);
    list-style: none;
    padding: 0;
    margin: var(--space-sm) 0 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .map-legend__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
  }
  .map-legend__dot {
    display: inline-block;
    width: 0.85em;
    height: 0.85em;
    border-radius: 50%;
    border: 1px solid rgb(0 0 0 / 25%);
    flex: none;
  }
  /* The divIcon wrapper shouldn't impose a white box background. */
  :global(.prs-pin) {
    background: transparent;
    border: none;
  }
  .map-popup__cat {
    display: inline-block;
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin-top: 2px;
  }
</style>

<script
  is:inline
  src={LEAFLET_JS}
  integrity={LEAFLET_JS_SRI}
  crossorigin="anonymous"
></script>

<script>
  function initMap() {
    const el = document.getElementById('prs-map');
    // @ts-expect-error Leaflet is a global from the pinned CDN script.
    const L = window.L;
    if (!el || !L) return;

    const cfg = JSON.parse(el.getAttribute('data-map') || '{}');
    const pins = cfg.pins || [];
    const denver = cfg.denver || { lat: 39.7392, lng: -104.9903, zoom: 11 };
    const base = cfg.base || '/';

    const map = L.map(el, { scrollWheelZoom: false }).setView(
      [denver.lat, denver.lng],
      denver.zoom
    );

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    }).addTo(map);

    // A small teardrop pin drawn as an inline SVG divIcon, tinted per pin.
    // No external marker images needed (keeps the site keyless/self-contained).
    function coloredIcon(color: string | undefined) {
      const c = color || '#7a4a2b';
      const svg =
        '<svg xmlns="http://www.w3.org/2000/svg" width="26" height="38" viewBox="0 0 26 38">' +
        '<path d="M13 0C5.8 0 0 5.8 0 13c0 9.2 13 25 13 25s13-15.8 13-25C26 5.8 20.2 0 13 0z" fill="' +
        c +
        '" stroke="#ffffff" stroke-width="2"/>' +
        '<circle cx="13" cy="13" r="5" fill="#ffffff"/></svg>';
      return L.divIcon({
        className: 'prs-pin',
        html: svg,
        iconSize: [26, 38],
        iconAnchor: [13, 38],
        popupAnchor: [0, -34],
      });
    }

    const markers = [];
    for (const p of pins) {
      if (typeof p.lat !== 'number' || typeof p.lng !== 'number') continue;
      const marker = L.marker([p.lat, p.lng], { icon: coloredIcon(p.color) }).addTo(map);
      const img = p.image
        ? `<img src="${base.replace(/\/$/, '')}/${String(p.image).replace(/^\//, '')}" alt="" />`
        : '';
      const cat = p.category ? `<span class="map-popup__cat">${p.category}</span>` : '';
      marker.bindPopup(
        `<div class="map-popup">
           <a class="map-popup__title" href="${p.href}">${p.name}</a>
           ${cat}
           ${img}
           <div><a href="${p.href}">Read more →</a></div>
         </div>`
      );
      markers.push(marker);
    }

    if (cfg.mode === 'single' && markers.length === 1) {
      map.setView(markers[0].getLatLng(), 15);
    } else if (markers.length > 1) {
      map.fitBounds(L.featureGroup(markers).getBounds().pad(0.2));
    }

    // Re-layout tiles when the viewport changes (mobile rotate/resize).
    const relayout = () => map.invalidateSize();
    window.addEventListener('resize', relayout);
    window.addEventListener('orientationchange', relayout);
    setTimeout(relayout, 200);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMap);
  } else {
    initMap();
  }
</script>
