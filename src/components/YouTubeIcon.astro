---
/*
 * YouTubeIcon.astro — a small inline YouTube glyph for use next to a title.
 *
 * Inline SVG so it scales with the surrounding text (sized in `em`), needs no
 * network request, and has no external dependency. Decorative by default
 * (aria-hidden); pass a `label` to announce it to screen readers instead.
 *
 *   <YouTubeIcon />
 *   <YouTubeIcon label="YouTube Short" />
 */
interface Props {
  /** Screen-reader label. When omitted, the icon is purely decorative. */
  label?: string;
}
const { label } = Astro.props;
---

<svg
  class="yt-icon"
  viewBox="0 0 24 24"
  role={label ? 'img' : undefined}
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  focusable="false"
>
  <path
    class="yt-icon__body"
    d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8Z"
  />
  <path class="yt-icon__play" d="M9.6 15.6V8.4l6.3 3.6-6.3 3.6Z" />
</svg>

<style>
  .yt-icon {
    display: inline-block;
    width: 1em;
    height: 1em;
    vertical-align: -0.125em; /* sit on the text baseline */
    margin-inline-end: 0.35em;
  }
  .yt-icon__body {
    fill: #ff0000; /* YouTube red — a brand mark, intentionally not themed */
  }
  .yt-icon__play {
    fill: #ffffff;
  }
</style>
